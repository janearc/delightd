# Per-workstation config for delightd. Copy to .env (gitignored) and set for this machine.
# Both the `delightd` wrapper (it sources this) and docker compose read it. Use absolute
# paths -- compose does not expand ~ -- and no spaces in values.

# --- Container mount roots ---
# /work (the read-only git-state source) and /var (delightd's writable state tree). Config
# is NOT mounted -- it is baked into the image. The fleet root is wherever your checkouts
# live: /opt/mesh, /usr/local/mesh, $HOME/mesh/prod -- the layout is yours, delightd only
# needs the absolute paths.
DELIGHT_MONITOR_ROOT_HOST=/absolute/path/to/your/fleet/root
DELIGHT_DAEMON_ROOT_HOST=/absolute/path/to/your/state/tree

# --- Kubernetes access (the light fake-EKS model; docs/kubernetes-access.md) ---
# The 1Password reference for the scoped ServiceAccount token, op://<vault>/<item>/<field>.
# The wrapper reads this host-side (op read, Touch ID) and delivers it to the container.
DELIGHT_TOKEN_ITEM=op://Personal/delightd-k8s-token/credential
# The 1Password reference for the control-port bearer the daemon requires on every mutating
# route (furnish up/down, backup, reset, register, /mcp). Fetched host-side like the k8s token.
DELIGHT_CONTROL_TOKEN_ITEM=op://Personal/delightd-control-token/credential
# The ring0-internal apiserver URL (finalized against the real k3d cluster at bring-up).
DELIGHT_APISERVER=https://k3d-fleet-serverlb:6443
# The host file holding the cluster CA that k3d writes (public, not a secret).
DELIGHT_CA_SOURCE=/absolute/path/to/your/home/.kube/k3d-fleet-ca.crt
# Where the wrapper stages the credential mount. MUST be under a path the container
# runtime shares with its VM (colima shares /Users on macOS, not /tmp). The wrapper
# defaults this; set it only to override.
DELIGHT_CREDS_DIR=/absolute/path/to/your/home/.delightd/creds
