# Host source paths for delightd's container mounts (docker-compose reads .env).
# Copy to .env and set for this workstation, or let the wrapper set them.
#
# The four roots are separate host locations -- ~/etc is not under ~/work -- so each
# is its own path, not derived from a single root. Use absolute paths (compose does
# not expand ~). When the workstation layout moves (#87) you change these, not the
# compose file.
DELIGHT_MONITOR_ROOT_HOST=/Users/you/work
DELIGHT_CONFIG_ROOT_HOST=/Users/you/etc/delightd
DELIGHT_DAEMON_ROOT_HOST=/Users/you/var
